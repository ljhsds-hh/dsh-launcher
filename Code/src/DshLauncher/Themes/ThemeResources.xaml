<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="https://handyorg.github.io/handycontrol">

    <!-- ═══════════════════════════════════════════════════════════════════════
         DshLauncher 设计系统
         ───────────────────────────────────────────────────────────────────────
         两层材质：
           ① 浅色机身 —— 页面底、面板、控件（安全、克制、留白充足）
           ② 深色仪表 —— 日志控制台（开发工具该有的"仪表感"，也是视觉焦点）
         所有颜色 / 字号 / 圆角 / 间距都是令牌，视图层不写死色值。

         只用 WPF 原生控件（Button/TextBox/CheckBox）的样式覆盖来实现视觉，
         交互控件仍走 HandyControl（hc:TextBox / hc:SearchBar / hc:NumericUpDown /
         hc:CircleProgressBar / hc:Tag / hc:Window）。

         ⚠ 资源键统一加 Ds 前缀，避免与 HandyControl 的同名键（BorderBrush、
           PrimaryTextBrush 等）互相覆盖。
         ═══════════════════════════════════════════════════════════════════════ -->

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- ══ 字体 ═════════════════════════════════════════════════════════════ -->
    <!-- Segoe UI 负责拉丁字母与数字（比雅黑更利落），CJK 落到 Microsoft YaHei UI -->
    <FontFamily x:Key="UiFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ══ 色板：机身 ═══════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="DsPageBrush" Color="#F5F6F8" />
    <SolidColorBrush x:Key="DsSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DsSurfaceSubtleBrush" Color="#FAFBFC" />
    <SolidColorBrush x:Key="DsBorderBrush" Color="#E4E7EC" />
    <SolidColorBrush x:Key="DsBorderStrongBrush" Color="#D6DBE3" />

    <!-- 文字（对白底对比度：18.1 / 5.98 / 4.74，全部过 WCAG AA） -->
    <SolidColorBrush x:Key="DsTextBrush" Color="#14161A" />
    <SolidColorBrush x:Key="DsTextSecondaryBrush" Color="#5B6472" />
    <SolidColorBrush x:Key="DsTextMutedBrush" Color="#6B7480" />
    <SolidColorBrush x:Key="DsTextFaintBrush" Color="#9AA3B0" />

    <!-- 强调色：取 DeepSeek 品牌蓝的色相，压深到白字 5.8:1 才敢当按钮底色 -->
    <SolidColorBrush x:Key="DsAccentLineBrush" Color="#4D6BFE" />
    <SolidColorBrush x:Key="DsAccentBrush" Color="#3B54E8" />
    <SolidColorBrush x:Key="DsAccentSoftBrush" Color="#EEF1FE" />
    <SolidColorBrush x:Key="DsAccentBorderBrush" Color="#C7D0FB" />

    <!-- 语义色（soft 系列只做浅底，正文一律用深色，避免浅色字不过对比度） -->
    <SolidColorBrush x:Key="DsSuccessBrush" Color="#15803D" />
    <SolidColorBrush x:Key="DsSuccessSoftBrush" Color="#F1FAF4" />
    <SolidColorBrush x:Key="DsSuccessBorderBrush" Color="#C6E3CE" />
    <SolidColorBrush x:Key="DsWarningBrush" Color="#B54708" />
    <SolidColorBrush x:Key="DsDangerBrush" Color="#B42318" />
    <SolidColorBrush x:Key="DsDangerSoftBrush" Color="#FEF5F4" />
    <SolidColorBrush x:Key="DsDangerBorderBrush" Color="#EEC7C3" />
    <SolidColorBrush x:Key="DsNeutralSoftBrush" Color="#F2F4F7" />

    <!-- ══ 色板：深色仪表（日志控制台） ═════════════════════════════════════ -->
    <!-- 对 #0D1117 对比度：正文 12.3 / 次要 6.2 / INFO 9.7 / WARN 9.7 / ERROR 7.5 / SYS 9.8 -->
    <SolidColorBrush x:Key="DsConsoleBrush" Color="#0D1117" />
    <SolidColorBrush x:Key="DsConsoleAltBrush" Color="#161B22" />
    <SolidColorBrush x:Key="DsConsoleBorderBrush" Color="#21262D" />
    <SolidColorBrush x:Key="DsConsoleTextBrush" Color="#C9D1D9" />
    <SolidColorBrush x:Key="DsConsoleDimBrush" Color="#8B949E" />
    <SolidColorBrush x:Key="DsConsoleFaintBrush" Color="#7A8291" />
    <SolidColorBrush x:Key="DsConsoleInfoBrush" Color="#79C0FF" />
    <SolidColorBrush x:Key="DsConsoleWarnBrush" Color="#E3B341" />
    <SolidColorBrush x:Key="DsConsoleErrorBrush" Color="#FF7B72" />
    <SolidColorBrush x:Key="DsConsoleSystemBrush" Color="#56D364" />
    <SolidColorBrush x:Key="DsConsoleSelectionBrush" Color="#1C2A44" />
    <SolidColorBrush x:Key="DsConsoleThumbBrush" Color="#30363D" />
    <SolidColorBrush x:Key="DsConsoleThumbHoverBrush" Color="#525A64" />

    <!-- ══ 排版 ═════════════════════════════════════════════════════════════ -->
    <Style x:Key="DsBrandTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DsTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="DsBrandSub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource DsTextMutedBrush}" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 微标签：小节标题（11px 半粗 + 弱色，靠"小"和"稳"区分层级） -->
    <Style x:Key="DsSectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DsTextMutedBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="DsFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource DsTextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="DsHintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource DsTextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>

    <Style x:Key="DsBodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource DsTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DsMonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource DsTextMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 一条 1px 浅色分隔线（布局/装饰用 Border，不用控件） -->
    <Style x:Key="DsHairline" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource DsBorderBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ══ 按钮 ═════════════════════════════════════════════════════════════ -->
    <!--
      一套模板吃所有变体：悬停/按下的反馈统一靠一层半透明"黑纱"叠在自身底色上，
      所以同一份模板对深底（强调）、白底（次要）、透明底（幽灵）都成立，
      不需要为每个变体各写一遍触发器。圆角固定 6，黑纱同圆角避免露角。
    -->
    <ControlTemplate x:Key="DsButtonTemplate" TargetType="Button">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="6"
                SnapsToDevicePixels="True">
            <Grid>
                <Border x:Name="Veil" Background="#FF000000" Opacity="0" CornerRadius="6" />
                <ContentPresenter x:Name="Presenter"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Veil" Property="Opacity" Value="0.07" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Veil" Property="Opacity" Value="0.15" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                <Setter TargetName="Veil" Property="Opacity" Value="0" />
            </Trigger>
            <!-- 键盘焦点环：只改边框色，边框宽度恒为 1，避免出现 1px 位移 -->
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource DsAccentLineBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 深色控制台里的按钮：白纱，黑纱在深底上等于没反馈 -->
    <ControlTemplate x:Key="DsButtonDarkTemplate" TargetType="Button">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="6"
                SnapsToDevicePixels="True">
            <Grid>
                <Border x:Name="Veil" Background="#FFFFFFFF" Opacity="0" CornerRadius="6" />
                <ContentPresenter x:Name="Presenter"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Veil" Property="Opacity" Value="0.10" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Veil" Property="Opacity" Value="0.20" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                <Setter TargetName="Veil" Property="Opacity" Value="0" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource DsAccentLineBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DsButtonBase" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource DsButtonTemplate}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- 主操作：整个界面只允许出现一个 -->
    <Style x:Key="DsButtonPrimary" TargetType="Button" BasedOn="{StaticResource DsButtonBase}">
        <Setter Property="Background" Value="{StaticResource DsAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DsAccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style x:Key="DsButtonSecondary" TargetType="Button" BasedOn="{StaticResource DsButtonBase}">
        <Setter Property="Background" Value="{StaticResource DsSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DsBorderStrongBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DsTextBrush}" />
    </Style>

    <!-- 幽灵：低优先级的工具动作（打开浏览器 / 设置 / 清空日志…） -->
    <Style x:Key="DsButtonGhost" TargetType="Button" BasedOn="{StaticResource DsButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource DsTextSecondaryBrush}" />
    </Style>

    <!-- 危险：用描边而不是整块红，避免和主按钮抢注意力 -->
    <Style x:Key="DsButtonDanger" TargetType="Button" BasedOn="{StaticResource DsButtonBase}">
        <Setter Property="Background" Value="{StaticResource DsSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DsDangerBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DsDangerBrush}" />
    </Style>

    <Style x:Key="DsButtonDarkGhost" TargetType="Button" BasedOn="{StaticResource DsButtonBase}">
        <Setter Property="Template" Value="{StaticResource DsButtonDarkTemplate}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource DsConsoleBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DsConsoleDimBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="28" />
    </Style>

    <!-- ══ 日志控制台 ═══════════════════════════════════════════════════════ -->
    <Style x:Key="LogLineText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 控制台的滚动条：HC 默认那条浅灰在深底上太扎眼，这里换成细窄深色 -->
    <Style x:Key="DsConsoleScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" Orientation="Horizontal">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBody"
                                                    Background="{StaticResource DsConsoleThumbBrush}"
                                                    CornerRadius="5"
                                                    Margin="2" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBody" Property="Background"
                                                            Value="{StaticResource DsConsoleThumbHoverBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="PART_Track" Property="Orientation" Value="Vertical" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 日志行容器：整行浅底 + 左侧强调色标记条，行本身内缩，和深色面板的圆角不打架 -->
    <Style x:Key="DsLogRowStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource DsConsoleTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row"
                            Margin="8,1"
                            CornerRadius="4"
                            Background="Transparent"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Marker" Grid.Column="0" Background="Transparent" Margin="0,3" CornerRadius="2" />
                            <ContentPresenter Grid.Column="1" Margin="9,3,8,3" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource DsConsoleAltBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource DsConsoleSelectionBrush}" />
                            <Setter TargetName="Marker" Property="Background" Value="{StaticResource DsAccentLineBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Row" Property="Background" Value="#243656" />
                            <Setter TargetName="Marker" Property="Background" Value="{StaticResource DsAccentLineBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
