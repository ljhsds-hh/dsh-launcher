<hc:Window x:Class="DshLauncher.Views.SettingsWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="DshLauncher 设置"
           Width="720"
           Height="780"
           MinWidth="640"
           MinHeight="560"
           WindowStartupLocation="CenterOwner"
           ResizeMode="CanResize"
           Background="{StaticResource DsPageBrush}"
           Foreground="{StaticResource DsTextBrush}"
           FontFamily="{StaticResource UiFontFamily}"
           FontSize="12.5"
           TextOptions.TextFormattingMode="Display"
           UseLayoutRounding="True"
           ShowNonClientArea="True"
           ShowTitle="True"
           ShowIcon="True"
           Icon="/Assets/app.ico">

    <!--
      和主界面同一套设计系统：浅机身 + 白卡片分组。
      每一组只讲一件事，说明文字紧跟它解释的那个开关，不集中堆在页尾。

      注意：输入框的属性都写在实例上，不给 hc:TextBox 挂 BasedOn 的自定义样式 ——
      HC 的隐式样式里带着水印模板，用 Style 覆盖会连同 InfoElement.Placeholder 一起丢掉。
    -->
    <Window.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DsSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- 勾选项下面那段解释：缩进对齐文字，不跟复选框图标对齐 -->
        <Style x:Key="CheckboxHint" TargetType="TextBlock" BasedOn="{StaticResource DsHintText}">
            <Setter Property="Margin" Value="22,5,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- masthead -->
        <Border Grid.Row="0"
                Background="{StaticResource DsSurfaceBrush}"
                BorderBrush="{StaticResource DsBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <StackPanel Height="64" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource DsBrandTitle}" Text="设置" />
                <TextBlock Style="{StaticResource DsBrandSub}" Text="命令、服务与日志的行为都在这里调，保存后立即生效" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="20" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">

                <!-- 命令 -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DsSectionLabel}" Text="命令" />

                        <TextBlock Style="{StaticResource DsFieldLabel}" Text="清理" />
                        <hc:TextBox Height="34" Padding="10,0" VerticalContentAlignment="Center"
                                    FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                    Text="{Binding CleanCommand, UpdateSourceTrigger=PropertyChanged}"
                                    hc:InfoElement.Placeholder="例如：pnpm run clean" />

                        <TextBlock Style="{StaticResource DsFieldLabel}" Text="构建" Margin="0,14,0,6" />
                        <hc:TextBox Height="34" Padding="10,0" VerticalContentAlignment="Center"
                                    FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                    Text="{Binding BuildCommand, UpdateSourceTrigger=PropertyChanged}"
                                    hc:InfoElement.Placeholder="例如：pnpm run build" />

                        <TextBlock Style="{StaticResource DsFieldLabel}" Text="启动" Margin="0,14,0,6" />
                        <hc:TextBox Height="34" Padding="10,0" VerticalContentAlignment="Center"
                                    FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                    Text="{Binding StartCommand, UpdateSourceTrigger=PropertyChanged}"
                                    hc:InfoElement.Placeholder="例如：pnpm dsh web" />

                        <TextBlock Style="{StaticResource DsHintText}" Margin="0,12,0,0"
                                   Text="命令在 DSH 仓库根目录下通过 cmd.exe 执行，与手动在终端里输入完全一致。" />
                    </StackPanel>
                </Border>

                <!-- 服务 -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DsSectionLabel}" Text="服务" />

                        <TextBlock Style="{StaticResource DsFieldLabel}" Text="端口" />
                        <hc:NumericUpDown Value="{Binding ServerPort}" Minimum="1" Maximum="65535"
                                          Increment="1" Width="170" HorizontalAlignment="Left" />

                        <CheckBox Margin="0,16,0,0" Content="端口被占用时仍允许启动"
                                  IsChecked="{Binding AllowStartWhenPortBusy}" />
                        <TextBlock Style="{StaticResource CheckboxHint}"
                                   Text="默认不勾选：端口已被占用通常说明已经有一个 DeepSeek Harness 在运行，此时再起一个实例会把两边都搞乱，所以「启动」会直接中止并提示。" />

                        <CheckBox Margin="0,16,0,0" Content="关闭启动器时保留 DSH 服务"
                                  IsChecked="{Binding KeepServiceRunningOnExit}" />
                        <TextBlock Style="{StaticResource CheckboxHint}"
                                   Text="默认勾选：关掉启动器不会把已经起来的 DSH 停掉，网页继续能用。想再停它，重新打开启动器点「停止」即可（它会自动找到占着端口的那个进程）。取消勾选则回到「关窗顺手收干净」。对清理 / 构建这类短步骤无效——它们始终会被收掉，免得留下半拉子构建。" />

                        <CheckBox Margin="0,16,0,0" Content="服务就绪后由启动器打开浏览器"
                                  IsChecked="{Binding OpenBrowserWhenReady}" />
                        <TextBlock Style="{StaticResource CheckboxHint}"
                                   Text="默认不勾选：pnpm dsh web 自身会打开浏览器，勾选后可能多出一个标签页。" />

                        <TextBlock Style="{StaticResource DsFieldLabel}" Text="就绪判定正则" Margin="0,16,0,6" />
                        <hc:TextBox Height="34" Padding="10,0" VerticalContentAlignment="Center"
                                    FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                    Text="{Binding ReadyPattern, UpdateSourceTrigger=PropertyChanged}"
                                    hc:InfoElement.Placeholder="例如：https?://(?:127\.0\.0\.1|localhost):\d+" />
                        <TextBlock Style="{StaticResource DsHintText}" Margin="0,8,0,0"
                                   Text="启动后日志中出现匹配内容即视为服务就绪；180 秒内没有匹配则按进程存活情况判断。" />
                    </StackPanel>
                </Border>

                <!-- 日志 -->
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DsSectionLabel}" Text="日志" />

                        <CheckBox Content="自动滚动到最新一行" IsChecked="{Binding AutoScroll}" />

                        <TextBlock Style="{StaticResource DsFieldLabel}" Text="最大保留行数" Margin="0,14,0,6" />
                        <hc:NumericUpDown Value="{Binding MaxLogLines}" Minimum="200" Maximum="200000"
                                          Increment="500" Width="170" HorizontalAlignment="Left" />

                        <CheckBox Margin="0,16,0,0" Content="把日志同步写入文件"
                                  IsChecked="{Binding WriteLogFile}" />
                        <TextBlock Style="{StaticResource CheckboxHint}"
                                   Text="开启后每次启动都会新建一个日志文件（文件名带启动时间），界面里出现的每一行都会落盘，关掉程序后这个文件就是本次运行的完整记录；只保留最近 14 个。" />

                        <TextBlock Style="{StaticResource DsFieldLabel}" Text="日志目录" Margin="0,16,0,6" />
                        <hc:TextBox Height="34" Padding="10,0" VerticalContentAlignment="Center"
                                    FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                    Text="{Binding LogDirectoryPath, Mode=OneWay}"
                                    IsReadOnly="True"
                                    Foreground="{StaticResource DsTextMutedBrush}" />

                        <TextBlock Style="{StaticResource DsFieldLabel}" Text="配置文件" Margin="0,14,0,6" />
                        <hc:TextBox Height="34" Padding="10,0" VerticalContentAlignment="Center"
                                    FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                    Text="{Binding ConfigFilePath, Mode=OneWay}"
                                    IsReadOnly="True"
                                    Foreground="{StaticResource DsTextMutedBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底栏 -->
        <Border Grid.Row="2"
                Background="{StaticResource DsSurfaceBrush}"
                BorderBrush="{StaticResource DsBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,0">
            <Grid Height="60">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="取消" Style="{StaticResource DsButtonGhost}" MinWidth="84"
                            Click="OnCancelClick" />
                    <Button Content="保存设置" Style="{StaticResource DsButtonPrimary}" MinWidth="104"
                            Margin="8,0,0,0" Click="OnSaveClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</hc:Window>
